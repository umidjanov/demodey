# ==============================================================================
# QUIZORA — Full Stack Environment Variables Configuration
# ==============================================================================

# General
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000

# Security & JWT
JWT_SECRET_KEY=quizora-dev-super-secure-jwt-secret-key-change-in-production-123456789
JWT_REFRESH_SECRET_KEY=quizora-dev-super-secure-refresh-key-change-in-production-987654321
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# MongoDB Connection
# Set MONGODB_URI to your local or Atlas URI.
# In development mode, if MongoDB is unreachable, QUIZORA will automatically operate in seamless fallback mode.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=quizora

# Redis (Optional in local dev, graceful fallback enabled)
REDIS_URI=redis://localhost:6379/0

# AI Provider Integration (OpenAI, Anthropic, or Gemini)
# Leave blank to use Quizora's built-in intelligent pedagogical heuristic engine.
AI_PROVIDER=gemini
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=gemini-1.5-flash

# Google OAuth 2.0 Credentials
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# YouTube Data API (Optional - Curated database used as primary fallback)
YOUTUBE_API_KEY=

# Public Frontend API URL (Used by Next.js client)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
